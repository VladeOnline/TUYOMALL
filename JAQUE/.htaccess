Options -Indexes
RewriteEngine On
AddType application/manifest+json .webmanifest

# Si alguien intenta abrir HTML privado directo, obligamos a pasar por PHP,
# donde se valida la sesion correspondiente.
RewriteRule ^dashboard-emprendedor\.html$ dashboard-emprendedor.php [L,QSA]
RewriteRule ^dashboard-cliente\.html$ dashboard-cliente.php [L,QSA]
RewriteRule ^negocio/([^/]+)/?$ perfil-publico.php?slug=$1 [L,QSA]
RewriteRule ^perfil/([^/]+)/?$ perfil-publico.php?slug=$1 [L,QSA]
RewriteRule ^p/([0-9]+)/?$ perfil-publico.php?producto=$1 [L,QSA]
RewriteRule ^dashboard-emprendedor/?$ dashboard-emprendedor.php [L,QSA]
RewriteRule ^dashboard-cliente/?$ dashboard-cliente.php [L,QSA]

# Carpetas internas: no deben ser navegables por URL.
RewriteRule ^(config|database|includes)/ - [F,L]

# Archivos sensibles o de despliegue que nunca deben descargarse desde public_html.
<FilesMatch "(\.(sql|txt|log|ini|env|bak|old|orig|save|zip|tar|gz|rar|7z|pem|key|lock)|^htaccess$|^composer\.(json|lock)$)$">
  Require all denied
</FilesMatch>

# Bloquea archivos ocultos como .env, .gitignore, .htpasswd, etc.,
# dejando pasar .well-known para SSL/certificados.
RewriteRule "(^|/)\.(?!well-known/)" - [F,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 6 months"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>
